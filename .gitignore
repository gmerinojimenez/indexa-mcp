# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
sdist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Secrets / local config (never commit tokens)
.env
.env.*
!.env.example
*.pem
*.key

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
